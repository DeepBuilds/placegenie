# ---- Application ----
APP_NAME=PlaceGenie AI
APP_ENV=development
APP_VERSION=0.1.0

# ---- Database (MySQL) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=placegenie
DB_PASSWORD=change_me
DB_NAME=placegenie

# ---- Security (used from Phase 3) ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Failed logins allowed within the window before further attempts are refused (429)
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_WINDOW_MINUTES=15

# ---- CORS: comma-separated list of allowed frontend origins ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Resume uploads ----
UPLOAD_DIR=uploads
RESUME_MAX_MB=5
RESUME_MAX_PAGES=10

# ---- Chatbot ----
# none      = no external AI; the built-in placement guide answers (the app works fully)
# anthropic = Claude via the Anthropic API;  openai = OpenAI or any OpenAI-compatible server
LLM_PROVIDER=none
LLM_API_KEY=
# Optional overrides (leave empty for sensible defaults)
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=600
# Send a short contact-free profile summary (branch, CGPA, skills, ...) to the LLM for personalised answers.
# Set to false to send only the question.
LLM_SHARE_PROFILE=true
CHAT_RATE_LIMIT_PER_MINUTE=15
